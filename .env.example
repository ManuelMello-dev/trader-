# Coinbase Advanced Trade API credentials
# Generate at: https://www.coinbase.com/settings/api
COINBASE_API_KEY=your_api_key_here
COINBASE_API_SECRET=your_api_secret_here

# Trading configuration
TRADING_PAIR=BTC-USD          # Product ID to trade (e.g. BTC-USD, ETH-USD)
QUOTE_CURRENCY=USD            # Quote currency used to fund trades
MAX_POSITION_PCT=0.10         # Max % of account to risk per trade (0.10 = 10%)
STOP_LOSS_ATR_MULT=1.5        # Stop-loss distance as a multiple of ATR
TAKE_PROFIT_ATR_MULT=3.0      # Take-profit distance as a multiple of ATR
MIN_RR_RATIO=2.0              # Minimum reward-to-risk ratio to enter a trade
CANDLE_GRANULARITY=ONE_HOUR   # Candle size: ONE_MINUTE, FIVE_MINUTE, FIFTEEN_MINUTE, ONE_HOUR, SIX_HOUR, ONE_DAY
LOOKBACK_CANDLES=200          # Number of candles to analyse for S/R and structure
PIVOT_WINDOW=5                # Swing-high/low detection window (bars each side)
SR_CLUSTER_PCT=0.005          # Price tolerance for clustering S/R levels (0.5%)
BOT_INTERVAL_SECONDS=300      # How often the main loop runs (seconds)
DRY_RUN=true                  # Set to false to place real orders
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
TRADE_LOG_FILE=trades.json    # File to persist trade history for adaptive learning
